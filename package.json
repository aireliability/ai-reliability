{
  "name": "ai-reliability",
  "private": true,
  "scripts": {
    "dev": "tsx apps/api/main.ts",
    "dev:api": "tsx apps/api/main.ts",
    "dev:api:openai": "node --env-file=.env --import tsx apps/api/dev-run-openai.ts",
    "dev:file:openai": "node --env-file=.env --import tsx apps/api/run-from-files.ts",
    "dev:file:deterministic": "tsx apps/api/run-from-files-deterministic.ts",
    "ci:eval": "node --env-file=.env --import tsx apps/api/ci-eval.ts",
    "ci:eval:deterministic": "tsx apps/api/ci-eval-deterministic.ts",
    "demo:failures": "tsx apps/api/demo-failures.ts",
    "demo:budget-gate": "tsx apps/api/demo-budget-gate.ts",
    "demo:maintenance-gate": "tsx apps/api/demo-maintenance-gate.ts",
    "agentqa:run": "tsx apps/api/agentqa-run.ts",
    "gate:release": "tsx apps/api/gate-release.ts",
    "test:budget-gate": "tsx --test packages/shared/budget-gate.test.ts",
    "test:maintenance-gate": "tsx --test packages/shared/maintenance-gate.test.ts packages/shared/agent-qa-spec-validator.test.ts packages/shared/agent-qa-doctor.test.ts packages/shared/agent-qa-artifacts.test.ts packages/shared/agent-qa-observations.test.ts packages/shared/agentqa-run.test.ts",
    "validate:spec": "tsx apps/api/validate-spec.ts",
    "doctor": "tsx apps/api/doctor.ts",
    "firewall:check": "tsx apps/api/firewall-check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3"
  }
}
